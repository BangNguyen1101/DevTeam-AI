# Copy to backend/.env and adjust. Never commit .env.

APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of origins allowed by CORS (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- SQL Server ---
DB_SERVER=localhost\BANG
DB_NAME=DevTeamAI
# ODBC driver installed on this machine ("ODBC Driver 18 for SQL Server" recommended)
DB_DRIVER=ODBC Driver 17 for SQL Server
# true = Windows Authentication; false = SQL login with DB_USER / DB_PASSWORD
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=
# Required by ODBC Driver 18 for local self-signed certificates
DB_TRUST_SERVER_CERTIFICATE=true
# Database used by pytest (created by scripts/create_db.sql)
DB_TEST_NAME=DevTeamAI_Test

# --- Authentication ---
# First admin account, created on startup only when the users table is empty.
# Use a strong password (>= 10 chars). Reset later with: python -m app.cli set-password <user>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_HOURS=12
# true when the app is served over HTTPS
COOKIE_SECURE=false

# --- Workspaces (files generated by agents) ---
WORKSPACES_ROOT=../workspaces

# --- LLM provider (any OpenAI Chat Completions compatible endpoint) ---
# Gemini free tier:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:            leave LLM_BASE_URL empty
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Used when LLM_API_KEY is empty (OpenAI only)
OPENAI_API_KEY=
