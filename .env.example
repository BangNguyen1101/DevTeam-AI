# Settings for `docker compose` (copy to .env next to docker-compose.yml). Never commit .env.

# SQL Server "sa" password inside the container: >= 8 chars with upper, lower, digit and symbol
MSSQL_SA_PASSWORD=

# First DevTeam AI account (created when the database has no users), >= 10 characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# LLM provider (Gemini free tier by default; leave LLM_BASE_URL empty for OpenAI)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# Port on this machine (bound to 127.0.0.1 only)
WEB_PORT=8080
# Set true only when serving over HTTPS (e.g. behind a tunnel)
COOKIE_SECURE=false
